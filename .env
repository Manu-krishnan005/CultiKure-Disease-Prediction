# ─────────────────────────────────────────────────────────────
# CultiKure Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# Required: Anthropic Claude API key for /explain endpoint
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Triton server URL (default: localhost for local dev, triton for Docker)
TRITON_URL=triton:8000

# Set to 'true' to route inference through Triton (production)
# Set to 'false' to use local PyTorch model (development)
USE_TRITON=true

# Flask settings
FLASK_ENV=production
PORT=5000

# Optional: CUDA device index (if multiple GPUs)
CUDA_VISIBLE_DEVICES=0
